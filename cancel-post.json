{
  "description": "Requiere deliveries:cancel. CREATED → CANCELLED con reason y cancelledAt. Si ya estaba CANCELLED responde 200 con el estado actual y conserva la razón y fecha originales. No existe edición ni borrado: para corregir datos, cancelar y crear otra solicitud.",
  "operationId": "DeliveryRequestsController_cancel",
  "parameters": [
    {
      "name": "publicId",
      "required": true,
      "in": "path",
      "description": "Identificador operacional (MDR-NNNNNN).",
      "schema": {
        "example": "MDR-000123",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "example": "El cliente canceló el pedido",
              "maxLength": 500
            }
          },
          "required": [
            "reason"
          ]
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "publicId": {
                "type": "string",
                "example": "MDR-000123",
                "description": "Identificador operacional global."
              },
              "externalReference": {
                "type": "string",
                "nullable": true,
                "example": "ORDER-1842"
              },
              "serviceType": {
                "type": "string",
                "enum": [
                  "LOCAL_DELIVERY"
                ],
                "example": "LOCAL_DELIVERY"
              },
              "status": {
                "type": "string",
                "enum": [
                  "CREATED",
                  "CANCELLED"
                ],
                "example": "CREATED"
              },
              "requestedAt": {
                "format": "date-time",
                "type": "string",
                "description": "Momento en que Mandaria aceptó la solicitud."
              },
              "cancelledAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "createdAt": {
                "format": "date-time",
                "type": "string"
              },
              "updatedAt": {
                "format": "date-time",
                "type": "string"
              },
              "cancellationReason": {
                "type": "string",
                "nullable": true,
                "example": null
              },
              "stops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "PICKUP",
                        "DROPOFF"
                      ]
                    },
                    "sequence": {
                      "type": "number",
                      "example": 1
                    },
                    "address": {
                      "type": "string",
                      "example": "Av. Central 123, Tuxtla Gutiérrez"
                    },
                    "latitude": {
                      "type": "number",
                      "example": 16.753554
                    },
                    "longitude": {
                      "type": "number",
                      "example": -93.115983
                    },
                    "contactName": {
                      "type": "string",
                      "example": "Restaurante Centro"
                    },
                    "contactPhone": {
                      "type": "string",
                      "example": "+52 961 123 4567"
                    },
                    "instructions": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "type",
                    "sequence",
                    "address",
                    "latitude",
                    "longitude",
                    "contactName",
                    "contactPhone"
                  ]
                }
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "enum": [
                        "FOOD",
                        "GROCERIES",
                        "MEDICINE",
                        "DOCUMENT",
                        "PARCEL",
                        "MERCHANDISE",
                        "OTHER"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "example": "Pedido preparado"
                    },
                    "quantity": {
                      "type": "number",
                      "example": 2
                    },
                    "weightKg": {
                      "type": "number",
                      "nullable": true,
                      "example": 1.5
                    },
                    "lengthCm": {
                      "type": "number",
                      "nullable": true
                    },
                    "widthCm": {
                      "type": "number",
                      "nullable": true
                    },
                    "heightCm": {
                      "type": "number",
                      "nullable": true
                    },
                    "isFragile": {
                      "type": "boolean",
                      "example": false
                    },
                    "handlingInstructions": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "category",
                    "description",
                    "quantity",
                    "isFragile"
                  ]
                }
              },
              "financialContext": {
                "type": "object",
                "properties": {
                  "goodsValue": {
                    "type": "string",
                    "nullable": true,
                    "example": "450.00",
                    "description": "Decimal string con 2 decimales; nunca float."
                  },
                  "goodsPaymentMode": {
                    "type": "string",
                    "enum": [
                      "PREPAID",
                      "COURIER_ADVANCE"
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "example": "MXN"
                  }
                },
                "required": [
                  "goodsPaymentMode",
                  "currency"
                ]
              }
            },
            "required": [
              "publicId",
              "serviceType",
              "status",
              "requestedAt",
              "createdAt",
              "updatedAt",
              "stops",
              "packages",
              "financialContext"
            ]
          }
        }
      }
    },
    "400": {
      "description": "Validación fallida: campos, stops (1 PICKUP + 1 DROPOFF), packages, contexto financiero, filtros o Idempotency-Key. No se aceptan campos desconocidos ni integrationClientId.",
