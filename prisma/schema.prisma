generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  PROVIDER_ADMIN
  DRIVER
}
enum IntegrationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}
enum CredentialStatus {
  ACTIVE
  REVOKED
}
/// Account state is derived (V1.6.1): active = ACTIVE; inactive without passwordHash = INVITED
/// (never activated); inactive with passwordHash = DISABLED. A CHECK forbids active without password.
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  /// null only while the account is INVITED; set exclusively by the account owner on activation.
  passwordHash String?
  role Role
  active Boolean @default(true)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  providerMemberships ProviderMembership[]
  driver Driver?
  invitations UserInvitation[] @relation("InvitationUser")
  deliveryAssignmentsCreated DeliveryAssignment[] @relation("DeliveryAssignmentAssignedBy")
  deliveryAssignmentsEnded DeliveryAssignment[] @relation("DeliveryAssignmentEndedBy")
  createdInvitations UserInvitation[] @relation("InvitationCreator")
  revokedInvitations UserInvitation[] @relation("InvitationRevoker")
  creditLedgerEntries CreditLedgerEntry[]
  independentProfilesApproved IndependentDriverProfile[] @relation("IndependentProfileApprover")
  independentProfilesSuspended IndependentDriverProfile[] @relation("IndependentProfileSuspender")
  independentProfilesRejected IndependentDriverProfile[] @relation("IndependentProfileRejecter")
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, revokedAt])
}
model IntegrationClient {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  status IntegrationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  credentials IntegrationCredential[]
  deliveryRequests DeliveryRequest[]
  idempotencyRecords ApiIdempotencyRecord[]
}
model IntegrationCredential {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  secretHash String @unique
  status CredentialStatus @default(ACTIVE)
  scopes String[] @default([])
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
}

enum ProviderType {
  FLEET
  INDEPENDENT
}
enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum ProviderMemberRole {
  OWNER
  ADMIN
}
model DeliveryProvider {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  type ProviderType
  status ProviderStatus @default(PENDING)
  maxDrivers Int
  maxVehicles Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships ProviderMembership[]
  drivers Driver[]
  vehicles Vehicle[]
  invitations UserInvitation[]
  serviceCoverages ProviderServiceCoverage[]
  dispatchCandidates DispatchCandidate[]
  deliveryAssignments DeliveryAssignment[]
  /// V1.10: exactly one per provider, created with it (trigger) and never deleted by the API.
  creditAccount CreditAccount?
  @@index([type, status])
  @@index([createdAt, id])
}
model ProviderMembership {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  userId String @db.Uuid
  role ProviderMemberRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider DeliveryProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([providerId, userId])
  @@index([userId, providerId])
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}
enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  PICKUP
  VAN
  TRUCK
  OTHER
}
enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}
/// Logistic profile of a User with global role DRIVER. Authentication stays in User.
model Driver {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  userId String @unique @db.Uuid
  name String
  status DriverStatus @default(PENDING)
  availability DriverAvailability @default(OFFLINE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider DeliveryProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments DriverVehicleAssignment[]
  deliveryAssignments DeliveryAssignment[]
  /// V1.9: explicit capability to operate for itself; never replaces providerId.
  independentProfile IndependentDriverProfile?
  claimedDispatches Dispatch[] @relation("DispatchIndependentClaim")
  @@unique([id, providerId])
  @@index([providerId, status, availability])
  @@index([providerId, createdAt, id])
}
/// Operational resource. V1.9: owned by a provider (fleet) XOR by an IndependentDriverProfile;
/// a CHECK in the migration forbids both and neither. Drivers only use a provider vehicle through
/// V1.4 assignments; an independent driver uses its own vehicles directly. The composite keys are
/// what stops a provider from assigning an independent vehicle (and the reverse) in SQL.
model Vehicle {
  id String @id @default(uuid()) @db.Uuid
  providerId String? @db.Uuid
  /// V1.9: set exactly when providerId is null; the vehicle belongs to this independent driver.
  independentDriverProfileId String? @db.Uuid
  identifier String
  type VehicleType
  status VehicleStatus @default(ACTIVE)
  brand String?
  model String?
  year Int?
  color String?
  plate String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider DeliveryProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  independentDriverProfile IndependentDriverProfile? @relation(fields: [independentDriverProfileId], references: [id], onDelete: Restrict)
  assignments DriverVehicleAssignment[]
  deliveryAssignments DeliveryAssignment[]
  @@unique([providerId, identifier])
  @@unique([id, providerId])
  @@unique([id, independentDriverProfileId])
  @@index([providerId, type, status])
  @@index([providerId, createdAt, id])
  @@index([independentDriverProfileId, status])
}
/// Assignment history. unassignedAt = null marks the active assignment; partial unique
/// indexes in the migration allow one active row per driver and per vehicle.
/// providerId is shared by both composite FKs, so driver and vehicle must belong to the same provider.
model DriverVehicleAssignment {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  driverId String @db.Uuid
  vehicleId String @db.Uuid
  assignedAt DateTime @default(now())
  unassignedAt DateTime?
  createdAt DateTime @default(now())
  driver Driver @relation(fields: [driverId, providerId], references: [id, providerId], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, providerId], references: [id, providerId], onDelete: Restrict)
  @@index([driverId, assignedAt])
  @@index([vehicleId, assignedAt])
}

/// V1.9 lifecycle. PENDING exists for a future public onboarding: V1.9 has no self-registration,
/// so SUPER_ADMIN moves a driver straight to APPROVED. REJECTED closes an application without
/// deleting history; SUSPENDED withdraws an approval and can be reverted by approving again.
enum IndependentDriverStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}
/// V1.9: an existing Driver that may also take dispatches for itself, with its own vehicles. It is
/// an explicit capability layered on the Driver, never a synthetic DeliveryProvider: the person
/// keeps one identity (User → Driver) and gains a second execution context. Nothing that already
/// belongs to Driver (name, status, availability, provider) is duplicated here.
model IndependentDriverProfile {
  id String @id @default(uuid()) @db.Uuid
  driverId String @unique @db.Uuid
  status IndependentDriverStatus @default(PENDING)
  approvedAt DateTime?
  approvedByUserId String? @db.Uuid
  suspendedAt DateTime?
  suspendedByUserId String? @db.Uuid
  rejectedAt DateTime?
  rejectedByUserId String? @db.Uuid
  /// Free-text motive of the last status change; never personal data.
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("IndependentProfileApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  suspendedBy User? @relation("IndependentProfileSuspender", fields: [suspendedByUserId], references: [id], onDelete: Restrict)
  rejectedBy User? @relation("IndependentProfileRejecter", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]
  deliveryAssignments DeliveryAssignment[]
  /// V1.10: created the first time the profile reaches APPROVED; kept through suspension.
  creditAccount CreditAccount?
  /// Lets DeliveryAssignment prove driver and profile match with a composite FK instead of a trigger.
  @@unique([id, driverId])
  @@index([status, createdAt])
}

enum DeliveryRequestStatus {
  CREATED
  CANCELLED
}
enum DeliveryStopType {
  PICKUP
  DROPOFF
}
enum PackageCategory {
  FOOD
  GROCERIES
  MEDICINE
  DOCUMENT
  PARCEL
  MERCHANDISE
  OTHER
}
enum GoodsPaymentMode {
  PREPAID
  COURIER_ADVANCE
}
/// Demand received from an IntegrationClient: what must be transported. Immutable except
/// for cancellation. No provider/driver/vehicle relation until Dispatch.
model DeliveryRequest {
  id String @id @default(uuid()) @db.Uuid
  /// MDR-000001; generated from sequence "DeliveryRequest_publicId_seq" inside the creation transaction.
  publicId String @unique
  integrationClientId String @db.Uuid
  externalReference String?
  /// V1.6: existing V1.5 rows migrate to LOCAL_DELIVERY (the only service offered).
  serviceType ServiceType @default(LOCAL_DELIVERY)
  status DeliveryRequestStatus @default(CREATED)
  requestedAt DateTime @default(now())
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  integrationClient IntegrationClient @relation(fields: [integrationClientId], references: [id], onDelete: Restrict)
  stops DeliveryStop[]
  packages DeliveryPackage[]
  financialContext DeliveryFinancialContext?
  quotes DeliveryQuote[]
  dispatches Dispatch[]
  @@index([integrationClientId, requestedAt, id])
  @@index([externalReference])
  @@index([status, requestedAt])
  @@index([requestedAt, id])
}
/// Address/contact snapshot; never linked to external restaurant or customer tables.
model DeliveryStop {
  id String @id @default(uuid()) @db.Uuid
  deliveryRequestId String @db.Uuid
  type DeliveryStopType
  sequence Int
  address String
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  contactName String
  contactPhone String
  instructions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  @@unique([deliveryRequestId, sequence])
}
model DeliveryPackage {
  id String @id @default(uuid()) @db.Uuid
  deliveryRequestId String @db.Uuid
  category PackageCategory
  description String
  quantity Int
  weightKg Decimal? @db.Decimal(10, 3)
  lengthCm Decimal? @db.Decimal(8, 2)
  widthCm Decimal? @db.Decimal(8, 2)
  heightCm Decimal? @db.Decimal(8, 2)
  isFragile Boolean @default(false)
  handlingInstructions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  @@index([deliveryRequestId])
}
/// Value of the goods and who pays for them at pickup. Not a delivery fee, wallet or credit.
model DeliveryFinancialContext {
  id String @id @default(uuid()) @db.Uuid
  deliveryRequestId String @unique @db.Uuid
  goodsValue Decimal? @db.Decimal(14, 2)
  goodsPaymentMode GoodsPaymentMode
  currency String @db.Char(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
}
/// Reusable B2B idempotency ledger. Stores only a payload hash, never the payload.
model ApiIdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid
  integrationClientId String @db.Uuid
  key String
  operation String
  requestHash String @db.Char(64)
  resourceType String
  resourceId String @db.Uuid
  createdAt DateTime @default(now())
  integrationClient IntegrationClient @relation(fields: [integrationClientId], references: [id], onDelete: Restrict)
  @@unique([integrationClientId, key])
}

/// Service catalogue. Only LOCAL_DELIVERY exists in V1.6; ERRAND/INTERCITY/FREIGHT are future values.
enum ServiceType {
  LOCAL_DELIVERY
}
enum ServiceZoneStatus {
  ACTIVE
  INACTIVE
}
enum RatePlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
}
/// Pricing strategy. BASE_PLUS_DISTANCE is planned but not implemented.
enum RateCalculationType {
  DISTANCE_BANDS
}
enum DeliveryQuoteStatus {
  OFFERED
  ACCEPTED
  EXPIRED
  CANCELLED
}
/// Operating area. boundary is a validated GeoJSON Polygon/MultiPolygon; the bbox columns
/// pre-filter candidates in SQL before the exact point-in-polygon check (PostGIS-replaceable).
model ServiceZone {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  status ServiceZoneStatus @default(INACTIVE)
  currency String @db.Char(3)
  boundary Json
  minLatitude Decimal @db.Decimal(9, 6)
  maxLatitude Decimal @db.Decimal(9, 6)
  minLongitude Decimal @db.Decimal(9, 6)
  maxLongitude Decimal @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ratePlans RatePlan[]
  quotes DeliveryQuote[]
  providerCoverages ProviderServiceCoverage[]
  @@index([status, minLatitude, maxLatitude, minLongitude, maxLongitude])
}
/// Versioned tariff for ServiceZone + ServiceType. Only DRAFT is editable; at most one ACTIVE.
model RatePlan {
  id String @id @default(uuid()) @db.Uuid
  serviceZoneId String @db.Uuid
  serviceType ServiceType
  version Int
  status RatePlanStatus @default(DRAFT)
  calculationType RateCalculationType @default(DISTANCE_BANDS)
  quoteValidityMinutes Int
  currency String @db.Char(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activatedAt DateTime?
  deactivatedAt DateTime?
  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  bands RateBand[]
  quotes DeliveryQuote[]
  @@unique([serviceZoneId, serviceType, version])
  @@unique([id, serviceZoneId])
  @@index([serviceZoneId, serviceType, status])
}
/// Distance band [minDistanceMeters, maxDistanceMeters): min inclusive, max exclusive.
model RateBand {
  id String @id @default(uuid()) @db.Uuid
  ratePlanId String @db.Uuid
  minDistanceMeters Int
  maxDistanceMeters Int
  amount Decimal @db.Decimal(14, 2)
  currency String @db.Char(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  quotes DeliveryQuote[]
  @@unique([ratePlanId, minDistanceMeters])
  @@unique([id, ratePlanId])
}
/// Immutable price snapshot for a DeliveryRequest. Only status and its timestamps change.
model DeliveryQuote {
  id String @id @default(uuid()) @db.Uuid
  /// MQ-000001; generated from sequence "DeliveryQuote_publicId_seq".
  publicId String @unique
  deliveryRequestId String @db.Uuid
  serviceType ServiceType
  serviceZoneId String @db.Uuid
  ratePlanId String @db.Uuid
  rateBandId String @db.Uuid
  distanceMeters Int
  durationSeconds Int
  amount Decimal @db.Decimal(14, 2)
  currency String @db.Char(3)
  routingProvider String
  routeCalculatedAt DateTime
  status DeliveryQuoteStatus @default(OFFERED)
  expiresAt DateTime
  acceptedAt DateTime?
  expiredAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Restrict)
  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  ratePlan RatePlan @relation(fields: [ratePlanId, serviceZoneId], references: [id, serviceZoneId], onDelete: Restrict)
  rateBand RateBand @relation(fields: [rateBandId, ratePlanId], references: [id, ratePlanId], onDelete: Restrict)
  dispatch Dispatch?
  @@index([deliveryRequestId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt, id])
  @@index([serviceZoneId, createdAt])
}

/// EXPIRED is not persisted: a PENDING invitation whose expiresAt has passed is reported as EXPIRED.
enum UserInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}
/// Invitation to activate a PROVIDER_ADMIN or DRIVER account for one provider. Stores only the
/// SHA-256 hash of the activation token. The ProviderMembership or Driver is materialized on
/// acceptance, so those tables keep holding active users only. At most one PENDING per user.
model UserInvitation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  /// Normalized (lowercase) email the invitation was sent to.
  email String
  role Role
  providerId String @db.Uuid
  /// PROVIDER_ADMIN only: local role of the membership created on acceptance.
  membershipRole ProviderMemberRole?
  /// DRIVER only: operational name of the Driver created on acceptance.
  driverName String?
  tokenHash String @unique @db.Char(64)
  status UserInvitationStatus @default(PENDING)
  expiresAt DateTime
  /// When the current token was generated (creation or last resend).
  tokenIssuedAt DateTime
  resendCount Int @default(0)
  acceptedAt DateTime?
  revokedAt DateTime?
  revokedByUserId String? @db.Uuid
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("InvitationUser", fields: [userId], references: [id], onDelete: Restrict)
  provider DeliveryProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  createdBy User @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User? @relation("InvitationRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([providerId, role, status, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt, id])
}

enum ProviderServiceCoverageStatus {
  ACTIVE
  INACTIVE
}
/// V1.7 operational enablement: a provider may take services of serviceType inside serviceZone
/// only while this row is ACTIVE (and the provider itself is ACTIVE). Managed by SUPER_ADMIN.
model ProviderServiceCoverage {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  serviceZoneId String @db.Uuid
  serviceType ServiceType
  status ProviderServiceCoverageStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider DeliveryProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  @@unique([providerId, serviceZoneId, serviceType])
  @@index([serviceZoneId, serviceType, status])
}

/// EXPIRED is persisted lazily: an OPEN dispatch past expiresAt is reported as EXPIRED and can
/// never be claimed. There is no NO_PROVIDER status: a dispatch without OFFERED candidates stays
/// OPEN until it expires and is flagged by the derived field noProviderAvailable.
enum DispatchStatus {
  OPEN
  CLAIMED
  EXPIRED
  CANCELLED
}
enum DispatchCandidateStatus {
  OFFERED
  CLAIMED
  RELEASED
}
/// V1.7: offer of an ACCEPTED quote to eligible providers. Created in the same transaction that
/// accepts the quote (one per quote). The winner is claimedByProviderId; no Driver/Vehicle yet.
model Dispatch {
  id String @id @default(uuid()) @db.Uuid
  deliveryRequestId String @db.Uuid
  deliveryQuoteId String @unique @db.Uuid
  status DispatchStatus @default(OPEN)
  openedAt DateTime
  expiresAt DateTime
  /// Current owner while CLAIMED; kept as history when a CLAIMED dispatch is CANCELLED.
  /// V1.9: mutually exclusive with claimedByIndependentDriverId (XOR CHECK in the migration).
  claimedByProviderId String? @db.Uuid
  /// V1.9: Driver.id of the independent that took the dispatch. A Driver id never travels in
  /// claimedByProviderId: each execution model has its own column and its own foreign key.
  claimedByIndependentDriverId String? @db.Uuid
  claimedAt DateTime?
  expiredAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryRequest DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  deliveryQuote DeliveryQuote @relation(fields: [deliveryQuoteId], references: [id], onDelete: Cascade)
  claimedByIndependentDriver Driver? @relation("DispatchIndependentClaim", fields: [claimedByIndependentDriverId], references: [id], onDelete: Restrict)
  candidates DispatchCandidate[]
  deliveryAssignments DeliveryAssignment[]
  @@index([deliveryRequestId])
  @@index([status, expiresAt])
  @@index([claimedByProviderId, status])
  @@index([claimedByIndependentDriverId, status])
  @@index([createdAt, id])
}
/// Snapshot of the providers a dispatch was offered to. Never recalculated or deleted.
model DispatchCandidate {
  id String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  providerId String @db.Uuid
  status DispatchCandidateStatus @default(OFFERED)
  offeredAt DateTime
  claimedAt DateTime?
  releasedAt DateTime?
  releaseReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  provider DeliveryProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  @@unique([dispatchId, providerId])
  @@index([providerId, status, dispatchId])
}

/// ACTIVE: the driver and vehicle currently operating the dispatch. REASSIGNED: replaced by a newer
/// assignment. CANCELLED: ended without replacement (unassign or delivery cancellation).
/// Execution states (picked up, in transit, delivered) belong to later versions.
enum DeliveryAssignmentStatus {
  ACTIVE
  REASSIGNED
  CANCELLED
}
enum DeliveryAssignmentEndReason {
  DRIVER_UNAVAILABLE
  VEHICLE_ISSUE
  OPERATIONAL_CHANGE
  DELIVERY_CANCELLED
  OTHER
}
/// V1.9: who executes a service. FLEET is the V1.8 model (a provider assigns one of its drivers).
/// INDEPENDENT is the driver itself, with its own vehicle and no provider involved.
enum DeliveryAssignmentMode {
  FLEET
  INDEPENDENT
}
/// V1.8/V1.9: which driver and vehicle execute a CLAIMED dispatch, in either execution mode. Rows
/// are never overwritten: reassignment ends the ACTIVE row and inserts a new one, keeping the
/// history. mode decides which owner column is set (XOR CHECK in the migration): FLEET carries
/// providerId, INDEPENDENT carries independentDriverProfileId. The partial unique indexes still
/// allow one ACTIVE row per dispatch, per driver and per vehicle — globally, so a driver busy as
/// fleet cannot also be busy as independent. `delivery_assignment_guard` replaces the V1.8
/// composite FKs: it proves, per mode, that driver and vehicle belong to the owner and that the
/// owner currently holds the dispatch claim.
model DeliveryAssignment {
  id String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  mode DeliveryAssignmentMode @default(FLEET)
  /// FLEET only; null for INDEPENDENT (never filled with a placeholder provider).
  providerId String? @db.Uuid
  /// INDEPENDENT only; null for FLEET.
  independentDriverProfileId String? @db.Uuid
  driverId String @db.Uuid
  vehicleId String @db.Uuid
  status DeliveryAssignmentStatus @default(ACTIVE)
  assignedAt DateTime
  assignedByUserId String @db.Uuid
  endedAt DateTime?
  endedByUserId String? @db.Uuid
  endReason DeliveryAssignmentEndReason?
  endReasonDetail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  provider DeliveryProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  independentDriverProfile IndependentDriverProfile? @relation(fields: [independentDriverProfileId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedBy User @relation("DeliveryAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedBy User? @relation("DeliveryAssignmentEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)
  @@index([dispatchId, assignedAt])
  @@index([providerId, status, assignedAt])
  @@index([independentDriverProfileId, status, assignedAt])
  @@index([driverId, assignedAt])
  @@index([vehicleId, assignedAt])
}

/// V1.10: who a CreditAccount belongs to. A fleet driver never has one: it works on its provider's.
enum CreditAccountOwnerType {
  PROVIDER
  INDEPENDENT_DRIVER
}
/// V1.10 sign convention (enforced by CHECK): RECHARGE and SERVICE_REFUND are credits (> 0),
/// SERVICE_AWARD is a debit (< 0), ADMIN_ADJUSTMENT may be either but never 0. Only RECHARGE and
/// ADMIN_ADJUSTMENT are produced in V1.10-A; the other two are reserved for claim/take charging.
enum CreditLedgerEntryType {
  RECHARGE
  SERVICE_AWARD
  SERVICE_REFUND
  ADMIN_ADJUSTMENT
}
/// How a manual recharge was paid outside Mandaria. A declaration by SUPER_ADMIN, not a gateway:
/// Mandaria never moves or verifies that money.
enum CreditRechargeMethod {
  TRANSFER
  CASH
  OTHER
}
/// V1.10: Mandaria credits — the commercial right to be awarded services. They are integers and
/// they are NOT money: not the delivery fee, not the goods value, not a driver's cash. Exactly one
/// owner column is set, matching ownerType (CHECK). balance is materialized for fast reads and
/// future claim-time checks, but it can only move through a CreditLedgerEntry: inserting an entry
/// updates it in the same statement (trigger), and a direct UPDATE of balance is rejected.
model CreditAccount {
  id String @id @default(uuid()) @db.Uuid
  ownerType CreditAccountOwnerType
  providerId String? @unique @db.Uuid
  independentDriverProfileId String? @unique @db.Uuid
  /// Whole credits, 0..1_000_000_000 (CHECK). Starts at 0: an account is never born with credits.
  balance Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider DeliveryProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  independentDriverProfile IndependentDriverProfile? @relation(fields: [independentDriverProfileId], references: [id], onDelete: Cascade)
  entries CreditLedgerEntry[]
  @@index([ownerType, createdAt])
}
/// V1.10: append-only history of an account. No row is ever updated, and deletion is refused too
/// (trigger). balanceAfter = balanceBefore + amount, and each entry's balanceBefore is the
/// account's balance at the moment it is written, so the chain ordered by sequence is gapless.
/// Every human movement carries an Idempotency-Key, unique per account.
model CreditLedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  /// Global insertion order. Movements of one account are serialized by its row lock, so ordering
  /// an account's entries by sequence reproduces the exact order they were applied in.
  sequence Int @unique @default(autoincrement())
  creditAccountId String @db.Uuid
  type CreditLedgerEntryType
  /// Signed whole credits: > 0 adds, < 0 removes. |amount| <= 1_000_000 per movement.
  amount Int
  balanceBefore Int
  balanceAfter Int
  /// RECHARGE only: how it was paid outside Mandaria.
  rechargeMethod CreditRechargeMethod?
  /// RECHARGE only: bank transfer folio, receipt number, etc. Never card data or credentials.
  externalReference String?
  /// Why the movement exists. Required for ADMIN_ADJUSTMENT and for RECHARGE with method OTHER.
  reason String?
  /// Reserved for SERVICE_AWARD / SERVICE_REFUND (e.g. DISPATCH + Dispatch.id). Unused in V1.10-A.
  referenceType String?
  referenceId String? @db.Uuid
  /// Human actor. Required for RECHARGE and ADMIN_ADJUSTMENT.
  createdByUserId String? @db.Uuid
  /// Client-supplied key, unique per account; only its request fingerprint is kept alongside it.
  idempotencyKey String?
  requestHash String? @db.Char(64)
  createdAt DateTime @default(now())
  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@unique([creditAccountId, idempotencyKey])
  @@index([creditAccountId, sequence])
  @@index([type, createdAt])
}
