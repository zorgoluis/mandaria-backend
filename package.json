{
  "name": "mandaria-backend",
  "version": "1.2.0",
  "description": "Mandaria independent logistics platform core",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ scripts/ --ignore-pattern src/generated",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docs:openapi": "nest build && node dist/openapi.cli.js && tsx scripts/generate-api-access.ts",
    "docs:check": "tsx scripts/generate-api-access.ts --check",
    "lint:eslint": "eslint src test prisma",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:test:deploy": "prisma migrate deploy --config prisma.test.config.ts",
    "db:test:reset": "prisma migrate reset --force --skip-seed --config prisma.test.config.ts",
    "pretest": "npm run build",
    "pretest:watch": "npm run build",
    "pretest:cov": "npm run build",
    "pretest:e2e": "npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.4",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.4",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^11.2.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.10.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "multer": "^2.3.0"
  }
}
