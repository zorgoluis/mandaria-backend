NODE_ENV=development
PORT=3000
# Generate a random hexadecimal password and set it in BOTH locations below.
POSTGRES_USER=mandaria
POSTGRES_DB=mandaria_db
POSTGRES_PASSWORD=12345678
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mandaria:12345678@localhost:5432/mandaria_db?schema=public&connect_timeout=5&socket_timeout=5
JWT_ACCESS_SECRET=1234567890
JWT_REFRESH_SECRET=1234567890
# Durations in seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Empty disables cross-origin browser access. Exact comma-separated origins only.
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
