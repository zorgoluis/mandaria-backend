NODE_ENV=development
PORT=3000
# Generate a random hexadecimal password and set it in BOTH locations below.
POSTGRES_USER=mandaria
POSTGRES_DB=mandaria
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mandaria:REPLACE_PASSWORD@localhost:5432/mandaria?schema=public&connect_timeout=5&socket_timeout=5
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations in seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Empty disables cross-origin browser access. Exact comma-separated origins only.
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

INTEGRATION_JWT_SECRET=
INTEGRATION_ACCESS_TOKEN_EXPIRES_IN=3600
DEFAULT_FLEET_MAX_DRIVERS=10
DEFAULT_FLEET_MAX_VEHICLES=10
DEFAULT_INDEPENDENT_MAX_DRIVERS=1
DEFAULT_INDEPENDENT_MAX_VEHICLES=2

# LOCAL/TEST ONLY: password for accounts created by npm run db:seed:local-provider-admins.
# Never set in production; the seed refuses NODE_ENV=production and non-local databases.
LOCAL_PROVIDER_ADMIN_PASSWORD=

# V1.6 routing. google (default) requires GOOGLE_ROUTES_API_KEY in production; never commit a real key.
# local_fake is LOCAL/TEST ONLY (straight-line estimate) and is rejected when NODE_ENV=production.
ROUTING_PROVIDER=google
GOOGLE_ROUTES_API_KEY=
# Per-attempt timeout (1000-15000 ms) and extra attempts for transient failures (0-2).
GOOGLE_ROUTES_TIMEOUT_MS=5000
GOOGLE_ROUTES_MAX_RETRIES=1
# DRIVE or TWO_WHEELER (availability of TWO_WHEELER depends on the country).
GOOGLE_ROUTES_TRAVEL_MODE=DRIVE

# V1.6.1 user provisioning (invitations). Accounts are created by invitation, never with an admin-chosen password.
# Base URL of Mandaria Web; emails link to {MANDARIA_WEB_URL}/activate-account?token=... (https required in production).
MANDARIA_WEB_URL=http://localhost:5173
# Invitation validity (1-168 hours) and minimum wait between resends of the same invitation (0-3600 s).
USER_INVITATION_TTL_HOURS=24
USER_INVITATION_RESEND_COOLDOWN_SECONDS=60
# smtp (required in production) or local_outbox (LOCAL/TEST ONLY: writes emails, including the activation link,
# as private JSON files under LOCAL_MAIL_OUTBOX_DIR or <OS temp>/mandaria-mail-outbox; rejected in production).
MAIL_PROVIDER=local_outbox
LOCAL_MAIL_OUTBOX_DIR=
# SMTP relay (any provider). Never commit real credentials.
MAIL_FROM=Mandaria <contacto@mandaria.com>
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS, which is mandatory in production.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# V1.7 dispatch: minutes an accepted service stays claimable by eligible providers (1-1440).
# Independent of the quote validity; after it an unclaimed dispatch is EXPIRED.
DISPATCH_TTL_MINUTES=10

# V1.8 assignment: minutes the claim owner has to assign a driver and vehicle (1-1440).
# Only the derived assignmentOverdue signal; nothing is released or reassigned automatically.
LOCAL_DELIVERY_ASSIGNMENT_TTL_MINUTES=5

# V1.9 independent drivers: how many own vehicles SUPER_ADMIN may register for one independent
# driver (1-100). They are the driver's own vehicles, not a fleet: no provider is involved.
INDEPENDENT_DRIVER_MAX_VEHICLES=3
