NODE_ENV=development
PORT=3000
# Generate a random hexadecimal password and set it in BOTH locations below.
POSTGRES_USER=mandaria
POSTGRES_DB=mandaria
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mandaria:REPLACE_PASSWORD@localhost:5432/mandaria?schema=public&connect_timeout=5&socket_timeout=5
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations in seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Empty disables cross-origin browser access. Exact comma-separated origins only.
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

INTEGRATION_JWT_SECRET=
INTEGRATION_ACCESS_TOKEN_EXPIRES_IN=3600
DEFAULT_FLEET_MAX_DRIVERS=10
DEFAULT_FLEET_MAX_VEHICLES=10
DEFAULT_INDEPENDENT_MAX_DRIVERS=1
DEFAULT_INDEPENDENT_MAX_VEHICLES=2

# LOCAL/TEST ONLY: password for accounts created by npm run db:seed:local-provider-admins.
# Never set in production; the seed refuses NODE_ENV=production and non-local databases.
LOCAL_PROVIDER_ADMIN_PASSWORD=
